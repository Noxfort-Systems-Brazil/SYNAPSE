# SYNAPSE Environment Settings Template
# Copy this file to .env and configure your local credentials.
# The .env file is ignored by Git and should NEVER be pushed to GitHub.

# Superuser credentials for local authentication
SYNAPSE_SUPERUSER=admin
SYNAPSE_SUPERUSER_PASSWORD=

# Optional PostgreSQL database connection overrides
SYNAPSE_DB_HOST=localhost
SYNAPSE_DB_PORT=5432
SYNAPSE_DB_USER=user_synapse
SYNAPSE_DB_PASSWORD=
SYNAPSE_DB_NAME=synapse_db
SYNAPSE_DB_SCHEMA=schema_synapse
